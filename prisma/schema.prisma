// Local SQLite store. The database file lives at data/exam-fm.db unless
// EXAM_FM_DATABASE_URL points elsewhere (tests use a temporary file).
datasource db {
  provider = "sqlite"
  url      = env("EXAM_FM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id              String            @id
  mode            String // DIAGNOSTIC | EXAM | CHALLENGE | PRACTICE | CONCEPT | REMEDIATION | TRANSFER
  status          String // ACTIVE | SUBMITTED
  difficulty      String // "1" | "2" | "3" | "4" | "mixed" | "hard" | "elite"
  timed           Boolean
  durationSeconds Int?
  elapsedSeconds  Int               @default(0)
  currentIndex    Int               @default(0)
  config          String            @default("{}") // JSON
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  submittedAt     DateTime?
  questions       SessionQuestion[]
}

model SessionQuestion {
  id                    String    @id
  sessionId             String
  session               Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position              Int
  templateId            String
  family                String
  topic                 String
  difficulty            Int
  payload               String // JSON QuestionInstance, including its validation record
  /// numeric | text | math | statements | composite | table. Rows stored before the rich answer model are numeric.
  answerType            String    @default("numeric")
  /// Structural item format (direct-calculation, equation-selection, statement-combination, …).
  itemFormat            String    @default("direct-calculation")
  /// calculation | concept — concept items feed concept mastery, not formula mastery.
  practice              String    @default("calculation")
  selectedKey           String?
  confidence            String?
  method                String?
  methodNote            String?
  working               String    @default("")
  flagged               Boolean   @default(false)
  timeSpentSeconds      Int       @default(0)
  isCorrect             Boolean?
  selectedMisconception String?
  answeredAt            DateTime?

  @@index([sessionId])
  @@index([templateId])
  @@index([practice])
}

/// Every validation attempt, including rejected drafts that never reached a session.
model ValidationLog {
  id         String   @id @default(uuid())
  templateId String
  level      Int
  seed       String
  status     String // PASSED | REJECTED
  record     String // JSON ValidationRecord
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([status])
}

/// One misconception (or weakly evidenced skill) moving through the remediation cycle.
model RemediationItem {
  id               String   @id @default(uuid())
  target           String // misconception id, or objective id for weak-reasoning items
  kind             String // MISCONCEPTION | WEAK_REASONING | CONCEPT
  objective        String
  sourceQuestionId String
  sourceTemplateId String
  stage            Int      @default(1) // 1-2: variations now, 3: delayed retest
  status           String // OPEN | SCHEDULED | RESOLVED
  dueAt            DateTime
  attempts         String   @default("[]") // JSON [{ questionId, templateId, correct, at }]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

/// Study area: one spaced-repetition card (formula or concept flashcard) and its schedule.
/// Rows are created on the first review; a card with no row is new.
model StudyCard {
  id             String    @id // e.g. "f:B.annuity-immediate:recall", "c:tvm.force-of-interest"
  deck           String // formulas | concepts
  ease           Float     @default(2.5)
  intervalDays   Float     @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastRating     String? // again | hard | good | easy
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deck])
  @@index([dueAt])
}

/// Study area: every answer given in a study tool (flashcard rating, quick check, formula drill,
/// concept question with instant feedback). Kept apart from exam-style sessions and their mastery.
model StudyAttempt {
  id      String   @id @default(uuid())
  kind    String // FLASHCARD | QUICK_CHECK | DRILL | CONCEPT_QUESTION
  itemId  String // card id, quick-check id, drill id or concept template id
  topic   String
  correct Boolean
  detail  String? // rating, chosen option, …
  at      DateTime @default(now())

  @@index([kind])
  @@index([itemId])
}

/// Stored summary figures (e.g. the dashboard analytics), keyed by name and
/// valid while `version` matches the history it was computed from.
model Snapshot {
  key       String   @id
  version   String
  data      String // JSON
  updatedAt DateTime @updatedAt
}
