# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_fm?schema=public"

# Optional. Base URL for step-by-step solution videos. Each question template
# resolves to <base>/<template-slug>, e.g.
#   https://player.example.com/embed/loan-outstanding-balance
# When unset, the review page shows the written derivation and an explicit
# "no video walkthrough yet" state instead of a broken embed.
NEXT_PUBLIC_SOLUTION_VIDEO_BASE_URL=""
