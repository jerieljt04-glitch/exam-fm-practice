# Optional settings. Copy to .env.local to use them; nothing here is required.

# Where the SQLite history is stored (default: data/exam-fm.db in the project folder).
# EXAM_FM_DATABASE_URL="file:/absolute/path/to/exam-fm.db"

# Optional language-model rewording of question text. Without a key the app uses
# its built-in, fully validated bank. The key stays on the server.
# ANTHROPIC_API_KEY=""
# EXAM_FM_LLM_MODEL="claude-opus-5-5"
# EXAM_FM_LLM="off"
