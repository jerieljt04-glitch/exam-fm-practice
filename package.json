{
  "name": "exam-fm-practice-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "prisma generate && next build",
    "start": "npm run db:setup && next start",
    "db:setup": "node scripts/db-setup.mjs",
    "postinstall": "prisma generate",
    "app:build": "bash scripts/build-desktop-app.sh",
    "app:open": "open -a \"Exam FM Practice\"",
    "app:stop": "bash scripts/stop-desktop-app.sh",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:sympy",
    "test:unit": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/tests/run.ts",
    "test:sympy": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/export-bank.ts && python3 scripts/validate_sympy.py",
    "validate:bank": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/probe.ts",
    "validate:choice": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/probe-choice.ts",
    "report:calibration": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/calibration-report.ts",
    "test:migration": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node --transpile-only scripts/test-migration.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@prisma/client": "^5.19.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "next": "^14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.0.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-katex": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.45",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.6.2"
  }
}
